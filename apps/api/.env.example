# StillMind API — Environment Variables
# Copy this to .env and fill in the values

# APP
APP_NAME=StillMind API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# SECURITY — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# DATABASE
DATABASE_URL=postgresql+asyncpg://stillmind:stillmind_secret@localhost:5432/stillmind

# REDIS
REDIS_URL=redis://localhost:6379/0

# SMTP (MailHog for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@stillmind.edu
SMTP_FROM_NAME=StillMind

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# FRONTEND
FRONTEND_URL=http://localhost:3000
