# ============================================================
# StillMind — Production Environment Variables (Template)
# ============================================================

# ---- Domain & URLs ----
DOMAIN=stillmind.civiclens.space
FRONTEND_URL=https://stillmind.civiclens.space
NEXT_PUBLIC_API_URL=/api/v1

# ---- Database ----
DB_NAME=stillmind
DB_USER=stillmind
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ---- Redis ----
REDIS_URL=redis://stillmind_redis:6379/0

# ---- Security ----
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_SECRET=your_session_secret

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://stillmind.civiclens.space/api/v1/auth/google/callback

# ---- SMTP (Email Notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=StillMind
SMTP_USE_TLS=true

# ---- Environment ----
ENVIRONMENT=production
DEBUG=false
