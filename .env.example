# ============================================================
# StillMind — Production Environment Variables
# ============================================================

# ---- Domain ----
DOMAIN=stillmind.civiclens.space

# ---- Database ----
# In production, use a strong password
DB_NAME=stillmind
DB_USER=stillmind
DB_PASSWORD=change_this_to_something_secure
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Security ----
# Generate a secure secret: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Environment ----
ENVIRONMENT=production
DEBUG=false

# ---- Frontend ----
# Usually just /api/v1 if Caddy is proxying
NEXT_PUBLIC_API_URL=/api/v1
